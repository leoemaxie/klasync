{
  "name": "klasync",
  "description": "Assistive learning platform for higher education — transforming physical lectures into live-captioned, searchable, AI-powered learning experiences.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write \"src/**/*.{ts,svelte}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte}\"",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "idb": "^8.0.4",
    "svelte": "^5.59.1",
    "svelte-spa-router": "^4.0.2",
    "three": "0.187.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/adapter-vercel": "^6.3.5",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.1",
    "@types/three": "0.187.0",
    "jsdom": "25.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.0"
}
