# Required to enable PostgreSQL-backed authentication and migrations.
DATABASE_URL=postgres://klasync:change-me@127.0.0.1:5432/klasync

# Generate a high-entropy value; do not commit a real secret.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_PREVIOUS_SECRETS=
UNIVERSITY_EMAIL_DOMAIN=university.edu

# Managed Redis is required in every environment. Use the complete `rediss://`
# URL supplied by your cloud provider; plaintext redis:// endpoints are rejected.
REDIS_URL=
REDIS_KEY_PREFIX=klasync:development
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30


# Public app URL used in account-recovery links.
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production transactional mail through Resend.
RESEND_API_KEY=
RESEND_FROM="KLASYNC <noreply@example.com>"

# Cloudflare R2's S3-compatible object-storage credentials. R2_ENDPOINT may be
# omitted when R2_ACCOUNT_ID is supplied.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# A vendor-neutral KLASYNC AI gateway. It receives portable job payloads and may
# be implemented by any model provider, local runtime, or orchestration layer.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# ---- AI ---------------------------------------------------------------------
# Provider selection: a Google API key routes everything to Gemini; without one,
# OpenRouter is used (and stays available as a last-resort fallback when both
# are set). AI_PROVIDER=auto|gemini|openrouter overrides the automatic choice.
AI_PROVIDER=auto
GEMINI_API_KEY=
# Ordered model chains per tier: the first is tried first, later ones are
# fallbacks (retired/erroring model) and escalations (unusable output).
# Cheap: rolling summaries, Q&A.  Mid: flashcards, chapters, concept maps, quizzes.
GEMINI_MODELS_CHEAP=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODELS_MID=gemini-3.5-flash-lite,gemini-4-hydrogen
GEMINI_MODELS_STRONG=gemini-4-neon
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Recordings longer than ~55 minutes exceed the transcribe model; this holds them.
GEMINI_LONG_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match vector(1536) in migration 0013.
EMBEDDING_DIMENSIONS=1536
# Batch (about half price, minutes to hours) is used for after-lecture material.
AI_BATCH_ENABLED=true
# Optional in-app daily spend cap in USD (0 = off; also set a cap in Google AI Studio).
AI_DAILY_BUDGET_USD=0
# Optional JSON price overrides: [{"model":"x","input":1.0,"output":2.0,"effective_from":"2027-01-01T00:00:00Z"}]
AI_PRICE_OVERRIDES=
# PEM bundle of extra trusted CAs for outbound HTTPS (TLS-inspecting proxies).
HTTP_EXTRA_CA_FILE=

# OpenRouter (used when no Google key is set). Free models are the default.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_SUMMARY_MODEL=openrouter/free
OPENROUTER_FLASHCARD_MODEL=openrouter/free
OPENROUTER_EXPLANATION_MODEL=openrouter/free
OPENROUTER_QA_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Paid fallback is opt-in; leave false to prevent unexpected spend.
OPENROUTER_PAID_FALLBACK_MODEL=
OPENROUTER_ALLOW_PAID_FALLBACK=false
# Flashcard/chapter JSON is long; 1200 truncated it mid-array and nothing was saved.
AI_MAX_OUTPUT_TOKENS=4096
