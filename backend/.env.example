# Required to enable PostgreSQL-backed authentication and migrations.
DATABASE_URL=postgres://klasync:change-me@127.0.0.1:5432/klasync

# Generate a high-entropy value; do not commit a real secret.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_PREVIOUS_SECRETS=
UNIVERSITY_EMAIL_DOMAIN=university.edu

# Managed Redis is required in every environment. Use the complete `rediss://`
# URL supplied by your cloud provider; plaintext redis:// endpoints are rejected.
REDIS_URL=
REDIS_KEY_PREFIX=klasync:development
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30


# Public app URL used in account-recovery links.
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production transactional mail through Resend.
RESEND_API_KEY=
RESEND_FROM="KLASYNC <noreply@example.com>"

# Cloudflare R2's S3-compatible object-storage credentials. R2_ENDPOINT may be
# omitted when R2_ACCOUNT_ID is supplied.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# A vendor-neutral KLASYNC AI gateway. It receives portable job payloads and may
# be implemented by any model provider, local runtime, or orchestration layer.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# OpenRouter AI routing. Free models are the default for lightweight tasks.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_SUMMARY_MODEL=openrouter/free
OPENROUTER_FLASHCARD_MODEL=openrouter/free
OPENROUTER_EXPLANATION_MODEL=openrouter/free
OPENROUTER_QA_MODEL=openrouter/free
# Paid fallback is opt-in; leave false to prevent unexpected spend.
OPENROUTER_PAID_FALLBACK_MODEL=
OPENROUTER_ALLOW_PAID_FALLBACK=false
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_COST_USD=0.02
