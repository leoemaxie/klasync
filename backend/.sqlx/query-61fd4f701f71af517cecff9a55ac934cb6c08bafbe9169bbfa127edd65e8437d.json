  "query": "select session.id as \"id!\", session.course_id as \"course_id!\", session.title as \"title!\", session.short_code as \"short_code!\", session.invite_token as \"invite_token!\", session.status as \"status!: SessionStatus\", session.started_at as \"started_at!\"\n         from session_invites invite join lecture_sessions session on session.id = invite.session_id\n         where invite.token = $1 and invite.revoked_at is null and (invite.expires_at is null or invite.expires_at > now())",
