{
  "db_name": "PostgreSQL",
  "query": "update session_participants participant set verification_status = $1, reviewed_by = $2, reviewed_at = now(), review_note = $3\n         from lecture_sessions session where participant.id = $4 and participant.session_id = session.id\n         and session.short_code = upper($5) and session.lecturer_id = $2\n         returning participant.id, participant.session_id, participant.matric_number, participant.display_name, participant.verification_status as \"verification_status: VerificationStatus\", participant.joined_at, participant.last_seen_at, participant.heartbeat_count",
