{
  "db_name": "PostgreSQL",
  "query": "select participant.id, participant.session_id, participant.matric_number, participant.display_name, participant.verification_status as \"verification_status: VerificationStatus\", participant.joined_at, participant.last_seen_at, participant.heartbeat_count\n         from session_participants participant\n         join lecture_sessions session on session.id = participant.session_id\n         where session.short_code = upper($1) and session.lecturer_id = $2 order by participant.joined_at",
