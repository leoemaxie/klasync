  "query": "update session_participants p set last_seen_at = now(), heartbeat_count = heartbeat_count + 1\n         from lecture_sessions s where p.id = $1 and p.session_id = s.id and s.status = 'live'\n         returning p.id, p.session_id, p.matric_number, p.display_name, p.verification_status as \"verification_status: VerificationStatus\", p.joined_at, p.last_seen_at, p.heartbeat_count",
